--- a/Mage.Server.Plugins/Mage.Player.AI.RL/src/mage/player/ai/ComputerPlayerMCTS2.java
+++ b/Mage.Server.Plugins/Mage.Player.AI.RL/src/mage/player/ai/ComputerPlayerMCTS2.java
@@ -136,8 +136,27 @@ public class ComputerPlayerMCTS2 extends ComputerPlayerMCTS {
     /**
      * core MCTS search implementation, with legality and transposition pruning
      */
+    // APPLYBENCH: applyEffects cost at the first priority search of each game on turns 5-8 (docs/perf/applybench.patch)
+    private boolean applyBenched = false;
+    private void applyBench(Game game, ActionEncoder.ActionType action) {
+        int turn = game.getTurnNum();
+        if (applyBenched || turn < 5 || turn > 8 || action != ActionEncoder.ActionType.PRIORITY) return;
+        applyBenched = true;
+        com.sun.management.ThreadMXBean mx = (com.sun.management.ThreadMXBean) java.lang.management.ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        Game sim = game.createSimulationForAI();
+        for (int w = 0; w < 300; w++) sim.applyEffects();
+        long a0 = mx.getThreadAllocatedBytes(tid), t0 = System.nanoTime();
+        for (int i = 0; i < 1000; i++) sim.applyEffects();
+        long a1 = mx.getThreadAllocatedBytes(tid), t1 = System.nanoTime();
+        logger.info(String.format("APPLYBENCH turn %d permanents %d effects %d: applyEffects %.1f us %d B",
+                turn, sim.getBattlefield().getAllPermanents().size(), sim.getContinuousEffects().getLayeredEffects(sim).size(),
+                (t1 - t0) / 1e6, (a1 - a0) / 1000));
+    }
+
     @Override
     protected void applyMCTS(final Game game, final ActionEncoder.ActionType action) {
+        applyBench(game, action);
         if(!action.equals(ActionEncoder.ActionType.PRIORITY)) {
             allMana = false;
         }
