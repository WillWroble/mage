diff --git a/cmd/enginebench/clone.go b/cmd/enginebench/clone.go
index b6e4edb..ae0139d 100644
--- a/cmd/enginebench/clone.go
+++ b/cmd/enginebench/clone.go
@@ -2,6 +2,7 @@ package main
 
 import (
 	"context"
+	"os"
 	"fmt"
 	"math/rand/v2"
 	"runtime"
@@ -85,7 +86,7 @@ func choicePoint(d *decision.Decision) bool {
 // first choice point (choicePoint) of that turn -- taken only from a game in
 // which every such root has a nonland permanent on both sides.
 func findRoots(w workload, base uint64) ([]*rules.Engine, []rootInfo, error) {
-	decks, names, err := w.decks("A")
+	decks, names, err := w.decks(rootPair)
 	if err != nil {
 		return nil, nil, err
 	}
@@ -240,6 +241,9 @@ func runClone(r *result, w workload, base uint64, copies int, step bool) error {
 				if err := c.Submit(cands[k%len(cands)]); err != nil {
 					panic(err)
 				}
+				if toChoice {
+					passToChoice(c)
+				}
 			}
 			sink = c
 		}
@@ -323,3 +327,29 @@ func mean(xs []float64) float64 {
 	}
 	return s / float64(len(xs))
 }
+
+// toChoice (GORGE_TO_CHOICE=1) makes a step run on to the next real choice: priority
+// decisions whose only options are pass/concede/activate are passed, the way MageZero's
+// MCTSPlayer auto-passes when pass is its only playable. autoPasses counts them.
+var toChoice = os.Getenv("GORGE_TO_CHOICE") == "1"
+var autoPasses, toChoiceSteps int
+
+func passToChoice(c *rules.Engine) {
+	toChoiceSteps++
+	for !c.G.Over && c.Pending() != nil && !choicePoint(c.Pending()) {
+		d := c.Pending()
+		pass := -1
+		for i, o := range d.Options {
+			if o.Kind == "pass" {
+				pass = i
+			}
+		}
+		if pass < 0 {
+			return
+		}
+		if err := c.Submit(decision.Intent{Seq: d.Seq, Player: d.Player, Choices: []int{pass}}); err != nil {
+			panic(err)
+		}
+		autoPasses++
+	}
+}
