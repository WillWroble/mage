diff --git a/Mage.Server.Plugins/Mage.Player.AI.RL/src/mage/player/ai/ComputerPlayerMCTS2.java b/Mage.Server.Plugins/Mage.Player.AI.RL/src/mage/player/ai/ComputerPlayerMCTS2.java
index e1d94b08e..9aac008e9 100644
--- a/Mage.Server.Plugins/Mage.Player.AI.RL/src/mage/player/ai/ComputerPlayerMCTS2.java
+++ b/Mage.Server.Plugins/Mage.Player.AI.RL/src/mage/player/ai/ComputerPlayerMCTS2.java
@@ -136,8 +136,38 @@ public class ComputerPlayerMCTS2 extends ComputerPlayerMCTS {
     /**
      * core MCTS search implementation, with legality and transposition pruning
      */
+    // COPYBENCH: state copy cost at the first priority search of each game on turns 5-8 (docs/perf/copybench.patch)
+    private boolean copyBenched = false;
+    private void copyBench(Game game, ActionEncoder.ActionType action) {
+        int turn = game.getTurnNum();
+        if (copyBenched || turn < 5 || turn > 8 || action != ActionEncoder.ActionType.PRIORITY) return;
+        copyBenched = true;
+        com.sun.management.ThreadMXBean mx = (com.sun.management.ThreadMXBean) java.lang.management.ManagementFactory.getThreadMXBean();
+        long tid = Thread.currentThread().getId();
+        mage.game.GameState snap = game.getState().snapshotCopy();
+        java.util.UUID id = java.util.UUID.randomUUID();
+        for (int w = 0; w < 300; w++) { game.getState().copy(); game.getState().snapshotCopy(); touch(snap.lazyCopy(), id); }
+        long a0 = mx.getThreadAllocatedBytes(tid), t0 = System.nanoTime();
+        for (int i = 0; i < 1000; i++) game.getState().copy();
+        long a1 = mx.getThreadAllocatedBytes(tid), t1 = System.nanoTime();
+        for (int i = 0; i < 1000; i++) touch(snap.lazyCopy(), id);
+        long a2 = mx.getThreadAllocatedBytes(tid), t2 = System.nanoTime();
+        for (int i = 0; i < 1000; i++) game.getState().snapshotCopy();
+        long a3 = mx.getThreadAllocatedBytes(tid), t3 = System.nanoTime();
+        logger.info(String.format("COPYBENCH turn %d permanents %d: copy %.1f us %d B, lazyCopy+touch all %.1f us %d B, snapshotCopy %.1f us %d B",
+                turn, game.getBattlefield().getAllPermanents().size(),
+                (t1 - t0) / 1e6, (a1 - a0) / 1000, (t2 - t1) / 1e6, (a2 - a1) / 1000, (t3 - t2) / 1e6, (a3 - a2) / 1000));
+    }
+    private static void touch(mage.game.GameState s, java.util.UUID id) {
+        s.getPlayers(); s.getBattlefield(); s.getTriggers(); s.getContinuousEffects(); s.getWatchers(); s.getDelayed();
+        s.getExile(); s.getStack(); s.getCommand(); s.getCombat(); s.getTurn(); s.getTurnMods(); s.getSpecialActions();
+        s.getRevealed(); s.getCompanion(); s.getHelperEmblems(); s.getPermanentCostsTags(); s.getMageObjectAttribute(id);
+        s.getValue("COPYBENCH"); s.getTriggered(id); s.getAllOtherAbilities(id);
+    }
+
     @Override
     protected void applyMCTS(final Game game, final ActionEncoder.ActionType action) {
+        copyBench(game, action);
         if(!action.equals(ActionEncoder.ActionType.PRIORITY)) {
             allMana = false;
         }
