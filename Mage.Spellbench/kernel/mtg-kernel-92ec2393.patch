+    let mut placed: Vec<Option<ObjectId>> = library
+        .iter()
+        .zip(order)
+        .map(|(&id, wanted)| (name(id) == *wanted).then_some(id))
+        .collect();
+    placed.resize(order.len(), None);
+    let mut left: Vec<ObjectId> = library
+        .iter()
+        .copied()
+        .filter(|id| !placed.contains(&Some(*id)))
+        .collect();
+    let mut arranged = Vec::with_capacity(order.len());
+    for (position, wanted) in order.iter().enumerate() {
+        if let Some(id) = placed[position] {
+            arranged.push(id);
+            continue;
+        }
+        let Some(index) = left.iter().position(|&id| name(id) == *wanted) else {
+            return Err(session_error(
+                RlSessionErrorCode::UnsupportedDeck,
+                &format!("library order names {wanted:?}, which the library does not have left"),
+            ));
+        };
+        arranged.push(left.remove(index));
+    }
+    if !left.is_empty() {
+        return Err(session_error(
+            RlSessionErrorCode::UnsupportedDeck,
+            "library order leaves library cards out",
+        ));
+    }
+    // A card some player knows the position of stays where it is: the host's order would move it only when it is
+    // behind this game (an arrangement it has not made yet), and is then left for later.
+    for observer in [PlayerId::P0, PlayerId::P1] {
+        for entry in state.known_library_cards(observer, player) {
+            if arranged.get(entry.position as usize) != Some(&entry.object) {
+                return Ok(());
+            }
+        }
+    }
+    state.players[player.index()].library = arranged;
+    Ok(())
+}
+
+/// A seat's library order by card name (top first) as card ids: one card of
+/// that name from the deck per entry, so the order is a permutation of the deck.
+fn library_card_ids_v1(deck: &[u16], order: &[String]) -> Result<Vec<u16>, RlSessionError> {
+    let mut left = deck.to_vec();
+    let mut ids = Vec::with_capacity(order.len());
+    for name in order {
+        let Some(index) = left.iter().position(|&id| crate::rl::card_name(id) == *name) else {
+            return Err(session_error(
+                RlSessionErrorCode::UnsupportedDeck,
+                &format!("library order names {name:?}, which the deck does not have left"),
+            ));
+        };
+        ids.push(left.swap_remove(index));
+    }
+    if !left.is_empty() {
+        return Err(session_error(
+            RlSessionErrorCode::UnsupportedDeck,
+            "library order leaves deck cards out",
+        ));
+    }
+    Ok(ids)
+}
