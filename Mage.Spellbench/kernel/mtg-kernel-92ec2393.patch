+    /// (a permutation of it by card name), and records the order it gives.
+    fn lockstep_shuffle_v1(&mut self, owner: PlayerId, shuffled: Vec<ObjectId>) -> Vec<ObjectId> {
+        if !self.engine.lockstep_shuffles.on {
+            return shuffled;
+        }
+        let seat = owner.index();
