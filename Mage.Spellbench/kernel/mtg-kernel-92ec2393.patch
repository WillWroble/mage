+/// Spellbench lockstep: the owner's shuffle `count` meets the host's. When
+/// this game made it already, its order (card names, top first) is returned
+/// for the host to take; else the host's `order` is kept for it.
+fn lockstep_shuffle_v1(
+    state: &mut crate::state::GameState,
+    player: PlayerId,
+    count: u32,
+    order: &[String],
+) -> Option<Vec<String>> {
+    let seat = player.index() as u8;
+    let shuffles = &mut state.engine.lockstep_shuffles;
+    if let Some((_, _, made)) = shuffles.results.iter().find(|(o, c, _)| *o == seat && *c == count) {
+        return Some(made.clone());
+    }
+    shuffles.host_orders.retain(|(o, c, _)| !(*o == seat && *c == count));
+    shuffles.host_orders.push((seat, count, order.to_vec()));
+    None
+}
